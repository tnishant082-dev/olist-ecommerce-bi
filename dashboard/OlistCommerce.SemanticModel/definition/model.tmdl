model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder", "fact_orders", "fact_order_items", "dim_date", "dim_customer", "dim_product", "dim_seller", "dim_state", "mart_cohort_retention", "_Measures"]

ref table fact_orders
ref table fact_order_items
ref table dim_date
ref table dim_customer
ref table dim_product
ref table dim_seller
ref table dim_state
ref table mart_cohort_retention
ref table _Measures
