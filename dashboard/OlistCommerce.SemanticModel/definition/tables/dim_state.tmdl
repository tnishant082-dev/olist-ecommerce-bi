		annotation SummarizationSetBy = Automatic

	partition dim_state = m
		mode: import
		source =
				let
				    Source = Parquet.Document ( File.Contents ( DataFolder & "\dim_state.parquet" ) ),
				    Typed = Table.TransformColumnTypes ( Source, {{"state", type text}, {"state_name", type text}, {"region", type text}} )
				in
				    Typed
